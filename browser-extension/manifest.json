{
  "manifest_version": 3,
  "name": "PC Radar - Ajout rapide Amazon",
  "version": "1.1",
  "description": "Ajoute un composant au catalogue PC Radar directement depuis une page produit Amazon (panneau intégré + icône).",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.fr/*",
        "https://www.amazon.com/*",
        "https://www.amazon.de/*",
        "https://www.amazon.co.uk/*"
      ],
      "js": ["categorize.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://pcradar.tech/*",
    "https://*.amazon.fr/*",
    "https://*.amazon.com/*",
    "https://*.amazon.de/*",
    "https://*.amazon.co.uk/*"
  ]
}
