{
  "manifest_version": 3,
  "name": "PC Radar - Ajout rapide Amazon",
  "version": "1.9",
  "description": "Gère le catalogue PC Radar depuis Amazon : produits pas encore sur le site mis en évidence, ajout groupé, prix mis à jour automatiquement sur les fiches et les pages de résultats, relevé automatique en arrière-plan.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.fr/*",
        "https://www.amazon.com/*",
        "https://www.amazon.de/*",
        "https://www.amazon.co.uk/*"
      ],
      "js": [
        "categorize.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://pcradar.tech/*",
    "https://*.amazon.fr/*",
    "https://*.amazon.com/*",
    "https://*.amazon.de/*",
    "https://*.amazon.co.uk/*"
  ]
}
